# --- Reference downloads: NOT tracked (re-fetched by the .qmd from MaizeGDB URLs) ---
# W22 genome FASTA (604 MB bgzip), decompressed copy (2 GB), gene GFF3, indexes.
data/*
!data/.gitkeep
# any stray e-PCR genome index
*.famap
*.hash

# --- work/ intermediates: keep ONLY the small extracted W22 target sequences ---
work/*
!work/locus.fa
!work/gene.gff3

# --- LH244 (mgd) intermediates and outputs: NOT tracked ---
# work_lh244/ is ~1.1 GB (decompressed GFF3s, TE track, BLAST DBs, interval BEDs) and holds
# files above GitHub's 100 MB limit; results_lh244/ is regenerated outputs. Both are rebuilt
# from scratch by mgd_LH244_primer_check.qmd, so only the .qmd and docs/ need tracking.
work_lh244/
results_lh244/

# --- Quarto / knitr / R render artifacts ---
/.quarto/
*_files/
*_cache/
*.knit.md
.Rproj.user/
.Rhistory
.RData

# --- misc ---
.DS_Store

# generated html (now rendered into docs/)
/mu1046085_primer_design.html

**/*.quarto_ipynb
